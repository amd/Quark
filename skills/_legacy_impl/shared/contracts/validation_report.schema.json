{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validation_report",
  "type": "object",
  "required": [
    "status",
    "summary",
    "evidence",
    "next_actions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applied_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
